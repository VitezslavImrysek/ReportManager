<UserControl x:Class="ReportManager.Client.Views.ReportConditionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ReportManager.Client.Views"
             xmlns:vm="clr-namespace:ReportManager.Client.ViewModels" xmlns:behaviors="clr-namespace:ReportManager.Client.Behaviors"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:QueryConditionsViewModel}"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="#DDD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Background" Value="#FAFAFA"/>
        </Style>
    </UserControl.Resources>
    <StackPanel>
        <ItemsControl ItemsSource="{Binding Conditions}">
            <ItemsControl.ItemContainerStyle>
                <Style TargetType="ContentPresenter">
                    <Setter Property="Margin" Value="0,6,0,0"/>
                </Style>
            </ItemsControl.ItemContainerStyle>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="Column:"/>
                                <TextBlock Grid.Column="1" Margin="8,0,8,0" VerticalAlignment="Center"
                                           Text="{Binding SelectedColumnLabel}" TextTrimming="CharacterEllipsis"/>
                                <Button Grid.Column="2" Margin="0" Padding="8,2"
                                        Content="Select column..." Command="{Binding SelectColumnCommand}"/>
                            </Grid>

                            <ComboBox ItemsSource="{Binding AvailableOps}"
                          SelectedItem="{Binding SelectedOp, Mode=TwoWay}"/>

                            <!-- Value1: non-lookup -->
                            <TextBox
                         Text="{Binding Value1, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Visibility="{Binding TextValue1Visibility}"
                         ToolTip="Value 1 (for IN you can enter: A,B,C or one per line)"/>

                            <!-- Lookup: single (Eq/Ne) -->
                            <ComboBox ItemsSource="{Binding SelectedColumn.LookupItems}"
                          DisplayMemberPath="Text"
                          SelectedItem="{Binding SelectedLookupItem, Mode=TwoWay}"
                          Visibility="{Binding LookupSingleVisibility}"
                          ToolTip="Pick a value from the lookup"/>

                            <!-- Lookup: multiselect for In/NotIn -->
                            <ListBox ItemsSource="{Binding SelectedColumn.LookupItems}"
                         DisplayMemberPath="Text"
                         SelectionMode="Extended"
                         Visibility="{Binding LookupMultiVisibility}"
                         ToolTip="Pick multiple values (CTRL/SHIFT)">
                                <behaviors:LookupMultiSelectBehavior.LookupMultiSelector>
                                    <behaviors:LookupMultiSelectBehavior BoundText="{Binding Value1, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </behaviors:LookupMultiSelectBehavior.LookupMultiSelector>
                            </ListBox>

                            <TextBox
                         Text="{Binding Value2, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Visibility="{Binding BetweenValue2Visibility}"
                         ToolTip="Value 2 (only for BETWEEN)"/>

                            <Button Content="Remove" Margin="{StaticResource FieldSpacing}" Command="{Binding RemoveCommand}"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Button Content="+ Add condition" Margin="{StaticResource FieldSpacing}" Command="{Binding AddConditionCommand}"/>
    </StackPanel>
</UserControl>
