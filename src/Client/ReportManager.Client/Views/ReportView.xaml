<UserControl x:Class="ReportManager.Client.Views.ReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:behaviors="clr-namespace:ReportManager.Client.Behaviors"
             xmlns:local="clr-namespace:ReportManager.Client"
             xmlns:views="clr-namespace:ReportManager.Client.Views"
             xmlns:vm="clr-namespace:ReportManager.Client.ViewModels"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:ReportViewModel}"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Server Query Panel -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <GroupBox Header="Report">
                    <StackPanel>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" Text="ReportKey:"/>
                            <TextBox Grid.Column="1" Margin="8,0,0,0" Text="{Binding ReportKey, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center"/>
                            <Button Grid.Column="2" Margin="8,0,0,0" Content="Load definition" Command="{Binding LoadManifestCommand}"/>
                        </Grid>

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" Text="UserId:"/>
                            <TextBox Grid.Column="1" Margin="8,0,0,0" Text="{Binding UserIdText, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center"/>
                        </Grid>

                        <UniformGrid Margin="0,8,0,0" Columns="2" Rows="1">
                            <Button Margin="0" Content="Load data" Command="{Binding QueryCommand}"/>
                            <Button Margin="8,0,0,0" Content="Clear filter" Command="{Binding ClearServerQueryCommand}"/>
                        </UniformGrid>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Conditions">
                    <views:ReportConditionsView DataContext="{Binding ConditionsVM}" />
                </GroupBox>

                <GroupBox Header="Sorting">
                    <views:ReportSortsView DataContext="{Binding SortSpecsVM}" />
                </GroupBox>

                <GroupBox Header="Columns">
                    <ItemsControl ItemsSource="{Binding ColumnVisibility}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding DisplayName}" IsChecked="{Binding IsVisible, Mode=TwoWay}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </GroupBox>

                <GroupBox Header="Presets">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox Grid.Row="0" Grid.Column="0"
                                  ItemsSource="{Binding Presets}"
                                  DisplayMemberPath="Name"
                                  SelectedItem="{Binding SelectedPreset}"/>
                        <Button Grid.Row="0" Grid.Column="1" Margin="8,6,0,0" Content="Load" Command="{Binding LoadPresetCommand}"/>
                        <Button Grid.Row="0" Grid.Column="2" Margin="8,6,0,0" Content="Overwrite" Command="{Binding OverwritePresetCommand}"/>

                        <TextBox Grid.Row="1" Grid.Column="0" Text="{Binding NewPresetName, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" />
                        <Button Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="8,6,0,0" Content="Save" Command="{Binding SavePresetCommand}"/>
                    </Grid>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <GridSplitter Grid.Column="1" Width="12" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

        <!-- DataGrid -->
        <DockPanel Grid.Column="2">
            <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding StatusText}"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Margin="0" Content="&lt;&lt; Previous" Command="{Binding PrevPageCommand}"/>
                    <Button Margin="8,0,0,0" Content="Next >>" Command="{Binding NextPageCommand}"/>
                    <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Text="PageSize:"/>
                    <TextBox Width="60" Margin="6,0,0,0" Text="{Binding PageSizeText, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center"/>
                </StackPanel>
                <Button Grid.Column="2" Margin="12,0,0,0" local:ContextMenuServiceEx.OpenOnLeftClick="True">
                    <Button.Content>
                        <DockPanel LastChildFill="True">
                            <TextBlock Text="Download" />
                            <TextBlock Text=" ▼" Margin="6,0,0,0" />
                        </DockPanel>
                    </Button.Content>

                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Csv" Command="{Binding DownloadReportCsvCommand}"/>
                            <MenuItem Header="Xlsx" Command="{Binding DownloadReportXlsxCommand}"/>
                            <MenuItem Header="Pdf" Command="{Binding DownloadReportPdfCommand}"/>
                            <MenuItem Header="Json" Command="{Binding DownloadReportJsonCommand}"/>
                            <Separator />
                            <MenuItem Header="Primary keys" Command="{Binding DownloadPrimaryKeysCommand}"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </Grid>

            <DataGrid x:Name="ReportGrid"
                  ItemsSource="{Binding RowsView}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserSortColumns="True"
                  CanUserReorderColumns="True"
                  CanUserResizeColumns="True"
                  AlternatingRowBackground="#F7F7F7"
                  GridLinesVisibility="Horizontal"
                  RowHeaderWidth="0"
                  ColumnReordered="ReportGrid_OnColumnReordered"/>
        </DockPanel>
    </Grid>
</UserControl>
