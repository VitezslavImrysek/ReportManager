<UserControl x:Class="ReportAdmin.App.Views.PresetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ReportAdmin.App.Views"
             xmlns:vm="clr-namespace:ReportAdmin.App.ViewModels"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:PresetViewModel}"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <local:PresetHeaderView Grid.Row="0" DataContext="{Binding HeaderVM}" />

        <TabControl Grid.Row="1" Margin="0,10,0,0">
            <TabItem Header="Columns">
                <local:ColumnsVisibilityView Margin="10" DataContext="{Binding ColumnsVM}" />
            </TabItem>

            <TabItem Header="Sorting">
                <local:SortView Margin="10" DataContext="{Binding SortVM}" />
            </TabItem>

            <TabItem Header="Filters">
                <local:FilterView Margin="10" DataContext="{Binding FilterVM}" />
            </TabItem>

            <TabItem Header="Texts">
                <local:TextsView DataContext="{Binding TextsVM}" />
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
