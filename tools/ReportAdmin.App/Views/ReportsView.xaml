<UserControl x:Class="ReportAdmin.App.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:converters="clr-namespace:ReportAdmin.App.Converters"
             xmlns:local="clr-namespace:ReportAdmin.App.Views" 
             xmlns:vm="clr-namespace:ReportAdmin.App.ViewModels"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:ReportsEditorViewModel}"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converters:LookupPresenceConverter x:Key="LookupPresenceConverter"/>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Column="0">
            <StackPanel DockPanel.Dock="Top">
                <TextBlock FontSize="16" FontWeight="SemiBold" Text="Reports"/>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Padding="10,4" Content="Open folder" Command="{Binding OpenFolderCommand}"/>
                    <Button Margin="8,0,0,0" Padding="10,4" Content="New report" Command="{Binding NewReportCommand}"/>
                </StackPanel>
                <TextBlock Margin="0,10,0,0" Foreground="#666" TextWrapping="Wrap" Text="{Binding RepoPath}"/>
                <Separator Margin="0,10,0,10"/>
                <TextBlock FontWeight="SemiBold" Text="Files"/>
            </StackPanel>

            <ListBox ItemsSource="{Binding ReportFiles}" SelectedItem="{Binding SelectedFile}" DisplayMemberPath="FileName" />
        </DockPanel>

        <GridSplitter Grid.Column="1" Width="12" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

        <local:ReportView Grid.Column="2" DataContext="{Binding ReportEditorVM}" />

        <StatusBar Grid.ColumnSpan="3" Grid.Row="1">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}" FontWeight="Bold" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</UserControl>
