<UserControl x:Class="ReportAdmin.App.Views.ReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ReportAdmin.App.Views"
             xmlns:vm="clr-namespace:ReportAdmin.App.ViewModels"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:ReportEditorViewModel}"
             d:DesignHeight="450" d:DesignWidth="800">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top">
            <StackPanel Orientation="Horizontal">
                <Button Padding="10,4" Content="Save &amp; Generate SQL" Command="{Binding SaveGenerateCommand}"/>
                <Button Margin="8,0,0,0" Padding="10,4" Content="Apply to DB" Command="{Binding ApplyToDbCommand}"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <TextBlock VerticalAlignment="Center" Text="Apply connection string:"/>
                <TextBox Margin="8,0,0,0" Width="980" Text="{Binding ApplyConnectionString, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>

            <Separator Margin="0,10,0,10"/>
        </StackPanel>

        <TabControl>
            <TabItem Header="Header">
                <local:ReportHeaderView Margin="10" DataContext="{Binding ReportHeaderVM}" />
            </TabItem>

            <TabItem Header="Columns">
                <local:ReportColumnsView Margin="10" DataContext="{Binding ReportColumnsEditorVM}" />
            </TabItem>

            <TabItem Header="Texts">
                <local:TextsEditorView Margin="10" DataContext="{Binding ReportTextsEditorVM}" />
            </TabItem>

            <TabItem Header="System Presets">
                <local:SystemPresetsView Margin="10" DataContext="{Binding SystemPresetsEditorVM}" />
            </TabItem>

            <TabItem Header="Generated SQL">
                <!-- TODO: Add regenerate button -->
                <TextBox Margin="10"
                     AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto"
                     Text="{Binding GeneratedSql}"
                     IsReadOnly="True"/>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
