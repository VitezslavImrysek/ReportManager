<UserControl x:Class="ReportAdmin.App.Views.SystemPresetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ReportAdmin.App.Views"
             xmlns:vm="clr-namespace:ReportAdmin.App.ViewModels"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:SystemPresetEditorViewModel}"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal">
            <TextBlock VerticalAlignment="Center" Text="PresetKey:"/>
            <TextBox Margin="8,0,0,0" Width="520" Text="{Binding PresetKey, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBlock Margin="16,0,0,0" VerticalAlignment="Center" Text="IsDefault:"/>
            <CheckBox Margin="8,0,0,0" IsChecked="{Binding IsDefault}"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
            <TextBlock VerticalAlignment="Center" Text="Name:"/>
            <TextBox Margin="8,0,0,0" Width="600" Text="{Binding Name}" IsReadOnly="True"/>
        </StackPanel>

        <TabControl Grid.Row="2" Margin="0,10,0,0">
            <TabItem Header="Columns">
                <DockPanel Margin="10">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                        <Button Padding="10,4" Content="Show all" Command="{Binding ShowAllColumnsCommand}"/>
                        <Button Margin="8,0,0,0" Padding="10,4" Content="Hide all" Command="{Binding HideAllColumnsCommand}"/>
                        <TextBlock Margin="16,0,0,0" VerticalAlignment="Center" Foreground="#666"
                           Text="Toggles only columns that are normally visible (not Hidden / AlwaysSelect)."/>
                    </StackPanel>

                    <DataGrid Margin="0,10,0,0" 
                              ItemsSource="{Binding Columns}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Key" Binding="{Binding Key}" Width="260" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Caption" Binding="{Binding Caption}" Width="*" IsReadOnly="True"/>
                            <DataGridCheckBoxColumn Header="Visible" Binding="{Binding IsVisible}" Width="90"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem Header="Sorting">
                <TabItem.Resources>
                    <CollectionViewSource x:Key="SortableColumns" Source="{Binding SortableColumns}" />
                    <CollectionViewSource x:Key="SortDirectionValues" Source="{Binding SortDirectionValues}" />
                </TabItem.Resources>

                <DockPanel Margin="10">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                        <Button Padding="10,4" Content="+ Add sort" Command="{Binding AddSortCommand}"/>
                        <Button Margin="8,0,0,0" Padding="10,4" Content="- Remove" Command="{Binding RemoveSortCommand}"/>
                        <Button Margin="16,0,0,0" Padding="10,4" Content="Up" Command="{Binding MoveSortUpCommand}"/>
                        <Button Margin="8,0,0,0" Padding="10,4" Content="Down" Command="{Binding MoveSortDownCommand}"/>
                    </StackPanel>

                    <DataGrid Margin="0,10,0,0"
                      ItemsSource="{Binding Sorting}"
                      SelectedItem="{Binding SelectedSort}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridComboBoxColumn Header="Column" Width="320"
                                            SelectedValueBinding="{Binding ColumnKey, UpdateSourceTrigger=PropertyChanged}"
                                            SelectedValuePath="Key"
                                            DisplayMemberPath="Key"
                                            ItemsSource="{Binding Source={StaticResource SortableColumns}}"/>
                            <DataGridComboBoxColumn Header="Direction" Width="140"
                                            SelectedItemBinding="{Binding Direction, UpdateSourceTrigger=PropertyChanged}"
                                            ItemsSource="{Binding Source={StaticResource SortDirectionValues}}"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Margin="0,10,0,0" Foreground="#666" TextWrapping="Wrap"
                       Text="Only columns with Sort.Enabled=true are selectable."/>
                </DockPanel>
            </TabItem>

            <TabItem Header="Filters">
                <TabItem.Resources>
                    <CollectionViewSource x:Key="FilterableColumns" Source="{Binding FilterableColumns}" />
                    <CollectionViewSource x:Key="FilterOperationValues" Source="{Binding FilterOperationValues}" />
                </TabItem.Resources>

                <DockPanel Margin="10">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                        <Button Padding="10,4" Content="+ Add filter" Command="{Binding AddFilterCommand}"/>
                        <Button Margin="8,0,0,0" Padding="10,4" Content="- Remove" Command="{Binding RemoveFilterCommand}"/>
                        <TextBlock Margin="16,0,0,0" VerticalAlignment="Center" Foreground="#666"
                           Text="Values: one per line. BETWEEN requires 2 lines. IS NULL ignores values."/>
                    </StackPanel>

                    <DataGrid Margin="0,10,0,0"
                      ItemsSource="{Binding Filters}"
                      SelectedItem="{Binding SelectedFilter}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridComboBoxColumn Header="Column" Width="320"
                                            SelectedValueBinding="{Binding ColumnKey, UpdateSourceTrigger=PropertyChanged}"
                                            SelectedValuePath="Key"
                                            DisplayMemberPath="Key"
                                            ItemsSource="{Binding Source={StaticResource FilterableColumns}}"/>
                            <DataGridComboBoxColumn Header="Op" Width="170"
                                            SelectedItemBinding="{Binding Operation, UpdateSourceTrigger=PropertyChanged}"
                                            ItemsSource="{Binding Source={StaticResource FilterOperationValues}}"/>
                            <DataGridTemplateColumn Header="Values" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox AcceptsReturn="True"
                                         MinHeight="60"
                                         VerticalScrollBarVisibility="Auto"
                                         Text="{Binding ValuesText, UpdateSourceTrigger=PropertyChanged}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem Header="Texts">
                <local:TextsEditorView DataContext="{Binding PresetsTextsEditorVM}" />
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
