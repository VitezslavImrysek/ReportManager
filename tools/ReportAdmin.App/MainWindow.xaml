<Window x:Class="ReportAdmin.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        xmlns:converters="clr-namespace:ReportAdmin.App.Converters"
        xmlns:vm="clr-namespace:ReportAdmin.App.ViewModels"
        xmlns:views="clr-namespace:ReportAdmin.App.Views"
        mc:Ignorable="d"
        Title="Report Admin"
        Height="900" Width="1450">
    <Grid Margin="12">
        <views:ReportsView>
            <views:ReportsView.DataContext>
                <vm:ReportsEditorViewModel />
            </views:ReportsView.DataContext>
        </views:ReportsView>
    </Grid>
</Window>
